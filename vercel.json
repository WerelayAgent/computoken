{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://coinputer.net/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://coinputer.net/_next/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
